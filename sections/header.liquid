<!-- sections/header.liquid -->
{% if section.settings.show_announcement %}
<div class="bg-[#1E2A44] text-white py-1.5 overflow-hidden border-b border-white/10">
  <div class="flex items-center text-[10px] font-bold tracking-wide uppercase whitespace-nowrap animate-marquee">
    {% for i in (1..5) %}
      <span class="px-4">ORDER BEFORE 5PM FOR SAME-DAY DISPATCH &bull; FREE DELIVERY ON ₹999+ &bull; COD AVAILABLE &bull; CUSTOMISATION AVAILABLE</span>
    {% endfor %}
  </div>
</div>
{% endif %}

<header class="bg-white border-b border-[#EDE3D8] sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex-1 md:hidden">
      <!-- Mobile Menu Toggle -->
      <button type="button" class="text-[#1B1B1B]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    
    <div class="flex-shrink-0 flex items-center justify-center flex-1 md:flex-none">
      <a href="/" class="text-xl md:text-2xl font-black tracking-tighter text-[#1E2A44] uppercase">
        Jersey Unicorn
      </a>
    </div>

    <div class="flex-1 flex justify-end items-center gap-4">
      <a href="/search" class="text-[#1B1B1B] hidden md:block">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </a>
      <a href="/cart" class="text-[#1B1B1B] relative hidden md:block">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        {% if cart.item_count > 0 %}
          <span class="absolute -top-2 -right-2 bg-[#e83e44] text-white text-[10px] font-bold h-4 w-4 rounded-full flex items-center justify-center">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    }
  ]
}
{% endschema %}
