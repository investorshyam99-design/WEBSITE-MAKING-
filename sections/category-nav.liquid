<script>
document.addEventListener('DOMContentLoaded', () => {
  const pills = document.querySelectorAll('.category-pill');

  pills.forEach(pill => {
    pill.addEventListener('click', (e) => {
      const targetId = pill.getAttribute('data-target');
      const targetEl = document.getElementById(targetId);

      if (targetEl) {
        const headerOffset = 110; // offset for sticky header + nav
        const elementPosition = targetEl.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
        
        window.scrollTo({
          top: offsetPosition,
          behavior: "smooth"
        });
      }
    });
  });

  // Intersection Observer for highlighting pills
  const sections = document.querySelectorAll('.category-section');
  if(sections.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          pills.forEach(p => {
            if(p.getAttribute('data-target') === id) {
              p.classList.add('bg-[#1E2A44]', 'text-white');
              p.classList.remove('bg-transparent', 'text-[#1E2A44]');
              p.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            } else {
              p.classList.remove('bg-[#1E2A44]', 'text-white');
              p.classList.add('bg-transparent', 'text-[#1E2A44]');
            }
          });
        }
      });
    }, { threshold: 0.3, rootMargin: '-10% 0px -50% 0px' });

    sections.forEach(sec => observer.observe(sec));
  }
});
</script>

