<!-- sections/category-nav.liquid -->
<div id="category-nav" class="sticky top-[64px] z-[40] bg-[#EDE3D8] transition-all duration-300 border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <div class="flex items-center gap-2 overflow-x-auto scrollbar-hide snap-x">
      {% assign categories = "FOOTBALL,FORMULA 1,ANIME,ARTISTS,WORD DRIP" | split: "," %}
      {% assign handles = "football,formula1,anime,artists,word-drip" | split: "," %}
      
      {% for cat in categories %}
        <button 
          data-target="section-{{ handles[forloop.index0] }}" 
          class="category-pill snap-start flex-shrink-0 px-4 py-2 rounded-full border-2 border-[#1E2A44] text-[#1E2A44] text-xs font-black tracking-wide uppercase transition-all duration-300 {% if forloop.first %}bg-[#1E2A44] text-white{% else %}bg-transparent hover:bg-[#1E2A44]/10{% endif %}"
        >
          {{ cat }}
        </button>
      {% endfor %}
    </div>
  </div>
</div>

