<!-- sections/categories-products.liquid -->
{% assign sections_data = "FOOTBALL|football|Football culture. Wear the game.|football,FORMULA 1|formula1|Built for those who live for speed.|formula-1,ANIME|anime|Drip for those who move in silence.|anime,ARTISTS|artists|Wear your obsession.|artists,WORD DRIP|word-drip|Words hit different on cotton.|word-drip" | split: "," %}

<div id="categories" class="bg-white py-12 md:py-16 space-y-16 md:space-y-24 scroll-mt-24">
  {% for item in sections_data %}
    {% assign parts = item | split: "|" %}
    {% assign title = parts[0] %}
    {% assign section_id = parts[1] %}
    {% assign subtitle = parts[2] %}
    {% assign tag_handle = parts[3] %}
    
    <section id="section-{{ section_id }}" class="category-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-32">
      
      <!-- Section Header -->
      <div class="flex items-center justify-between mb-6 md:mb-8">
        <div class="bg-[#14213D] border-l-4 border-[#E6C9A8] rounded-r-xl py-3 px-5 md:py-4 md:px-6 shadow-sm inline-block min-w-[200px] max-w-[85%]">
          <h2 class="text-white text-[20px] font-black uppercase tracking-tight leading-none">{{ title }}</h2>
          <p class="text-white/60 text-[11px] font-bold tracking-wide uppercase mt-1.5">{{ subtitle }}</p>
        </div>
        
        <a href="/collections/{{ tag_handle }}" class="flex items-center gap-1 text-gray-400 font-bold uppercase tracking-widest text-xs hover:text-[#e83e44] transition-colors">
          View All <span class="text-lg leading-none">&rarr;</span>
        </a>
      </div>

      <!-- Product Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5">
        {% assign collection = collections[tag_handle] %}
        
        {% if collection.products.size > 0 %}
          {% for product in collection.products limit: 4 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        {% else %}
          <!-- Empty State Placeholder -->
          <div class="col-span-full">
            <div class="text-center py-8 mb-4">
              <p class="text-[#1E2A44] font-black uppercase tracking-widest text-sm">🔥 Dropping Soon — follow us to be the first to know</p>
            </div>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5">
              {% for i in (1..2) %}
                <div class="animate-pulse">
                  <div class="aspect-[3/4] bg-gray-200 rounded-xl mb-3 shimmer-bg"></div>
                  <div class="h-3 bg-gray-200 rounded w-1/3 mb-2 shimmer-bg"></div>
                  <div class="h-4 bg-gray-200 rounded w-3/4 mb-3 shimmer-bg"></div>
                  <div class="h-5 bg-gray-200 rounded w-1/4 shimmer-bg"></div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
      
    </section>
  {% endfor %}
</div>

<style>
.shimmer-bg {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
</style>

{% schema %}
{
  "name": "Category Sections",
  "presets": [
    {
      "name": "Category Sections"
    }
  ]
}
{% endschema %}
