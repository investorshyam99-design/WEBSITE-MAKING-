<!-- sections/main-product.liquid -->
<div class="min-h-screen bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-12">
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-16">
      
      <!-- Left: Image Gallery -->
      <div class="flex-1 lg:max-w-2xl">
        <div class="sticky top-20">
          <div class="aspect-[3/4] bg-[#F5EFE6] rounded-2xl overflow-hidden relative mb-4">
            <img id="main-product-image" 
                 src="{{ product.featured_image | img_url: '1000x' }}" 
                 alt="{{ product.title | escape }} | Jersey Unicorn" 
                 class="w-full h-full object-cover">
            {% if product.compare_at_price > product.price %}
              {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
              <div class="absolute top-4 left-4 bg-[#e83e44] text-white text-xs font-black px-3 py-1.5 rounded-full shadow-sm">
                -{{ discount }}%
              </div>
            {% endif %}
          </div>
          
          <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-hide snap-x">
            {% for image in product.images %}
              <button onclick="document.getElementById('main-product-image').src='{{ image | img_url: '1000x' }}'; document.querySelectorAll('.thumb-btn').forEach(b => b.classList.remove('border-[#1E2A44]')); this.classList.add('border-[#1E2A44]');" 
                      class="thumb-btn w-20 h-24 flex-shrink-0 rounded-xl overflow-hidden border-2 transition-all snap-start {% if forloop.first %}border-[#1E2A44]{% else %}border-transparent hover:border-gray-300{% endif %}">
                <img src="{{ image | img_url: '200x' }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover">
              </button>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Right: Product Details -->
      <div class="flex-1 lg:max-w-md pt-2 lg:pt-0">
        <!-- Badges -->
        <div class="flex items-center gap-2 mb-3">
          <span class="bg-gray-100 text-gray-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest">{{ product.type | default: 'Word Drip' }}</span>
          <div class="flex items-center gap-1 text-amber-500">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span class="text-xs font-bold text-gray-600">4.5 <span class="text-gray-400 font-medium">(352 Reviews)</span></span>
          </div>
        </div>

        <h1 class="text-3xl md:text-4xl font-black text-[#1B1B1B] uppercase tracking-tight leading-[1.1]">{{ product.title }}</h1>
        
        <!-- Task 4A: Live Viewer Count -->
        <div class="mt-2 flex items-center gap-2 text-[#e83e44] font-bold text-[13px]">
          <span>🔥</span>
          <span class="transition-opacity duration-400 opacity-100" id="viewer-count-container"><span id="viewer-count">14</span> people are viewing this right now</span>
        </div>

        <div class="flex items-end gap-3 mt-4 mb-3">
          <span class="text-3xl font-black text-[#1E2A44] leading-none">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="text-lg text-gray-400 line-through font-bold mb-0.5">{{ product.compare_at_price | money }}</span>
          {% endif %}
        </div>

        <!-- Task 4C: Recent Orders Ticker -->
        <div class="bg-[#f8f9fc] rounded-lg px-3 py-2 mb-8 flex items-center gap-2 overflow-hidden h-9">
          <span class="text-green-500 flex-shrink-0 text-sm">✅</span>
          <div class="relative w-full h-full overflow-hidden">
            <div id="orders-ticker" class="absolute inset-0 flex flex-col justify-center text-[11px] text-[#555] italic transition-all duration-500">
              <div class="ticker-msg">Arjun from Delhi just ordered this &bull; 2 mins ago</div>
            </div>
          </div>
        </div>

        {% form 'product', product, id: 'add-to-cart-form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id">

          <!-- Task 4B: Low Stock Badge -->
          <div id="inventory-badge-container">
            {% assign inv_qty = product.selected_or_first_available_variant.inventory_quantity %}
            {% if inv_qty < 5 and inv_qty > 0 %}
              <div class="mb-4 flex items-center gap-2 px-3 py-2 bg-[#fee2e2] border border-[#fca5a5] rounded-lg text-[#dc2626] font-bold text-[12px] w-fit animate-[pulse_1.5s_infinite]">
                🔴 Only {{ inv_qty }} left — this size is almost gone!
              </div>
            {% elsif inv_qty >= 5 and inv_qty <= 15 %}
              <div class="mb-4 flex items-center gap-2 px-3 py-2 bg-[#fef3c7] border border-[#fcd34d] rounded-lg text-[#b45309] font-bold text-[12px] w-fit">
                ⚡ Almost gone — only {{ inv_qty }} remaining
              </div>
            {% elsif inv_qty > 15 and inv_qty <= 30 %}
              <div class="mb-4 flex items-center gap-2 px-3 py-2 bg-[#dcfce7] border border-[#86efac] rounded-lg text-[#16a34a] font-bold text-[12px] w-fit">
                ✅ Selling fast — grab yours now
              </div>
            {% endif %}
          </div>

          <!-- Variants -->
          {% unless product.has_only_default_variant %}
            <div class="space-y-6 mb-8 border-t border-gray-100 pt-6">
              {% for option in product.options_with_values %}
                <div>
                  <div class="flex justify-between items-center mb-3">
                    <h3 class="text-[11px] font-black text-gray-500 uppercase tracking-widest">{{ option.name }}</h3>
                  </div>
                  
                  {% if option.name == 'Color' or option.name == 'Colour' %}
                    <div class="flex flex-wrap gap-3">
                      {% for value in option.values %}
                        <label class="cursor-pointer group">
                          <input type="radio" name="options[{{ option.name }}]" value="{{ value | escape }}" class="peer sr-only variant-selector" {% if option.selected_value == value %}checked{% endif %}>
                          <div class="w-8 h-8 rounded-full border-2 border-gray-200 peer-checked:border-[#1E2A44] peer-checked:p-0.5 transition-all flex items-center justify-center">
                            <span class="w-full h-full rounded-full block shadow-inner" style="background-color: {{ value | downcase }};"></span>
                          </div>
                        </label>
                      {% endfor %}
                    </div>
                  {% else %}
                    <div class="flex flex-wrap gap-2">
                      {% for value in option.values %}
                        <label class="cursor-pointer shrink-0 select-none">
                          <input type="radio" name="options[{{ option.name }}]" value="{{ value | escape }}" class="peer sr-only variant-selector size-selector" {% if option.selected_value == value %}checked{% endif %}>
                          <div class="relative w-11 h-11 md:w-12 md:h-12 border rounded-md flex items-center justify-center transition-all duration-200 text-sm font-bold tracking-tight border-gray-200 bg-white text-[#1B1B1B] peer-checked:bg-[#1E2A44] peer-checked:text-white peer-checked:border-[#1E2A44] peer-checked:font-extrabold hover:border-black">
                            <span>{{ value }}</span>
                          </div>
                        </label>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <!-- Task 4D: Cart Reservation Warning -->
          <div id="reservation-warning" class="hidden text-[#92400e] text-[12px] font-semibold bg-[#fffbeb] px-3 py-2 border-l-[3px] border-[#f59e0b] rounded-r-md mb-6 flex items-center gap-2 opacity-0 transition-opacity duration-300">
            <span>⚡</span> Add to cart now to reserve this size — we can't hold it otherwise
          </div>

          <!-- Task 4B: Low Stock Badge -->
          {% assign inv_qty = product.selected_or_first_available_variant.inventory_quantity %}
          {% if inv_qty < 5 and inv_qty > 0 %}
            <div class="mb-4 flex items-center gap-2 px-3 py-2 bg-red-50 border border-red-100 rounded-lg text-red-700 font-bold uppercase text-[11px] tracking-wider w-fit animate-pulse">
              🔴 Only {{ inv_qty }} left — selling out fast!
            </div>
          {% elsif inv_qty >= 5 and inv_qty <= 15 %}
            <div class="mb-4 flex items-center gap-2 px-3 py-2 bg-amber-50 border border-amber-100 rounded-lg text-amber-800 font-bold uppercase text-[11px] tracking-wider w-fit">
              🟡 Almost gone — {{ inv_qty }} remaining
            </div>
          {% elsif inv_qty > 15 and inv_qty <= 30 %}
            <div class="mb-4 flex items-center gap-2 px-3 py-2 bg-green-50 border border-green-100 rounded-lg text-green-800 font-bold uppercase text-[11px] tracking-wider w-fit">
              🟢 Selling fast — grab yours
            </div>
          {% endif %}

          <button type="submit" id="main-atc-btn" class="w-full bg-[#1E2A44] text-white py-4 rounded-xl font-black uppercase tracking-widest shadow-md hover:bg-[#151D2F] hover:-translate-y-0.5 transition-all text-sm flex items-center justify-center gap-2">
            Add to Cart
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          </button>
        {% endform %}

        <!-- Task 7F: Prepaid Benefits -->
        <div class="mt-8 bg-[#1B1B1B] text-white p-5 rounded-2xl border border-gray-800">
          <h3 class="text-xs font-black uppercase tracking-widest text-[#E6C9A8] mb-4">Prepaid Benefits</h3>
          <ul class="space-y-3 text-xs font-bold tracking-wide">
            <li class="flex items-center gap-3"><span class="text-green-400 text-base">✅</span> Extra ₹50 OFF on prepaid orders</li>
            <li class="flex items-center gap-3"><span class="text-green-400 text-base">✅</span> Faster Dispatch</li>
            <li class="flex items-center gap-3"><span class="text-green-400 text-base">✅</span> Priority Processing</li>
          </ul>
        </div>

        <!-- Description (Collapsible style via details) -->
        <div class="mt-8 border-t border-gray-100 pt-6">
          <details class="group cursor-pointer" open>
            <summary class="flex items-center justify-between font-black uppercase tracking-widest text-xs list-none">
              Details
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <div class="mt-4 prose prose-sm text-gray-500 font-medium leading-relaxed max-w-none">
              {{ product.description }}
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Task 4E: Sticky Add to Cart (Mobile) -->
<div id="sticky-atc-bar" class="fixed bottom-[56px] left-0 right-0 h-16 bg-white border-t-2 border-[#1E2A44] z-[250] md:hidden translate-y-full transition-transform duration-250 ease-out px-3 flex items-center justify-between">
  <div class="flex items-center gap-3 max-w-[50%]">
    <div class="w-10 h-[52px] rounded-lg bg-[#F5EFE6] flex items-center justify-center overflow-hidden flex-shrink-0">
      <img src="{{ product.featured_image | img_url: '100x' }}" class="w-full h-full object-cover" alt="{{ product.title | escape }}">
    </div>
    <div class="flex flex-col">
      <span class="text-[11px] font-black uppercase text-[#1B1B1B] line-clamp-1 leading-tight">{{ product.title }}</span>
      <span class="text-[14px] font-black text-[#1E2A44]">{{ product.price | money }}</span>
    </div>
  </div>
  <button onclick="document.getElementById('add-to-cart-form').submit();" class="bg-[#1E2A44] text-white px-4 py-2.5 rounded-lg font-black uppercase text-[11px] active:scale-95 transition-transform flex-shrink-0 whitespace-nowrap">
    ADD TO CART
  </button>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Task 4A: Live Viewer Count
  const viewerContainer = document.getElementById('viewer-count-container');
  const viewerEl = document.getElementById('viewer-count');
  
  if (viewerEl && viewerContainer) {
    // Initial random value
    let current = Math.floor(Math.random() * 17) + 8; // 8 to 24
    viewerEl.innerText = current;
    
    setInterval(() => {
      let change = Math.floor(Math.random() * 7) - 3; // -3 to +3
      let next = current + change;
      if (next < 8) next = 8;
      if (next > 24) next = 24;
      current = next;
      
      viewerContainer.style.opacity = 0;
      setTimeout(() => {
        viewerEl.innerText = next;
        viewerContainer.style.opacity = 1;
      }, 400);
    }, 45000);
  }

  // Task 4C: Recent Orders Ticker
  const tickerEl = document.getElementById('orders-ticker');
  const fakeOrders = [
    "Arjun from Delhi just ordered this &bull; 2 mins ago",
    "Priya from Bangalore just ordered this &bull; 5 mins ago",
    "Rohan from Mumbai just ordered this &bull; just now",
    "Siddharth from Pune just ordered this &bull; 3 mins ago",
    "Vikrant from Chennai just ordered this &bull; 8 mins ago",
    "Neha from Hyderabad just ordered this &bull; 1 min ago",
    "Aarav from Ahmedabad just ordered this &bull; 4 mins ago",
    "Ananya from Kolkata just ordered this &bull; 6 mins ago"
  ];
  let orderIndex = 0;
  
  if(tickerEl) {
    setInterval(() => {
      orderIndex = (orderIndex + 1) % fakeOrders.length;
      tickerEl.style.transform = 'translateY(-15px)';
      tickerEl.style.opacity = 0;
      
      setTimeout(() => {
        tickerEl.style.transition = 'none';
        tickerEl.style.transform = 'translateY(15px)';
        tickerEl.innerHTML = `<div class="ticker-msg">${fakeOrders[orderIndex]}</div>`;
        
        // Force reflow
        void tickerEl.offsetWidth;
        
        tickerEl.style.transition = 'all 0.5s ease-in-out';
        tickerEl.style.transform = 'translateY(0)';
        tickerEl.style.opacity = 1;
      }, 500);
    }, 7000);
  }

  // Task 4D: Reservation Warning on Size Select
  const sizeSelectors = document.querySelectorAll('.size-selector');
  const resWarning = document.getElementById('reservation-warning');
  
  if(resWarning) {
    sizeSelectors.forEach(el => {
      el.addEventListener('change', () => {
        resWarning.classList.remove('hidden');
        // trigger reflow
        void resWarning.offsetWidth;
        resWarning.style.opacity = 1;
      });
    });
  }

  // Task 4E: Sticky Mobile ATC
  const mainAtc = document.getElementById('main-atc-btn');
  const stickyAtc = document.getElementById('sticky-atc-bar');
  
  if(mainAtc && stickyAtc) {
    const observer = new IntersectionObserver((entries) => {
      const entry = entries[0];
      // Show sticky when main ATC is scrolled out of view ABOVE the viewport
      if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
        stickyAtc.classList.remove('translate-y-full');
      } else {
        stickyAtc.classList.add('translate-y-full');
      }
    }, { threshold: 0 });
    observer.observe(mainAtc);
  }
});
</script>

<style>
.ticker-msg {
  display: flex;
  align-items: center;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>

{% schema %}
{
  "name": "Product Layout",
  "settings": []
}
{% endschema %}
